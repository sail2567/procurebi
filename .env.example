# ===== 大模型（OpenAI 兼容协议）=====
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL_SQL=deepseek-chat
LLM_MODEL_FAST=deepseek-chat
LLM_MOCK=false

# ===== PostgreSQL =====
DATABASE_URL=postgresql+asyncpg://bi:bi@localhost:5432/bi
# 仅 docker-compose.prod.yml 使用；本地开发以 DATABASE_URL 为准
POSTGRES_USER=bi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bi

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== 应用 =====
APP_ENV=dev
# 国内服务器构建镜像时可指定 PyPI 镜像（默认官方源）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
UPLOAD_MAX_MB=20
QUERY_ROW_LIMIT=500
QUERY_TIMEOUT_SECONDS=10

# ===== 登录与权限 =====
# 生产环境务必替换为随机长字符串（例如 python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=procurebi_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12

# 首次启动且数据库中没有任何管理员时创建；开发环境留空会使用 admin123456 并强制改密
ADMIN_BOOTSTRAP=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 登录失败限流（Redis 不可用时自动关闭）
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCKOUT_SECONDS=300
TRUST_PROXY_HEADERS=false

# 公开分享链接限流（Redis 不可用时自动放行）
SHARE_RATE_MAX_REQUESTS=60
SHARE_RATE_WINDOW_SECONDS=300

# 多币种报表：账单币种为 USD 时按该汇率折算为 CNY
FX_USD_CNY=7.2
